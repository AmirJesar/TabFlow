
{
  "manifest_version": 3,
  "name": "TabFlow",
  "version": "1.0",
  "description": "A smart browser tab manager",
  "permissions": [
    "tabs",
    "storage"
  ],
  "optional_permissions": [
    "tabGroups"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabFlow"
  }
}
